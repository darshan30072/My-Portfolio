# Contact form — Resend (https://resend.com)
# 1. Create a free account
# 2. Create an API key
# 3. (Optional) Verify your domain for a custom from-address
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where messages should be delivered
CONTACT_TO_EMAIL=example@gmail.com

# Sender shown in the inbox (must be a verified domain in Resend, or use their onboarding address)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- AI Portfolio Assistant (self-hosted Ollama) ---
# See SETUP-CHATBOT.md for the full walkthrough.

# Native Ollama API root. Keep the trailing /api. Point this at a tunnelled
# / remote URL instead of localhost if Next.js and Ollama run on different
# machines.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Only needed if OLLAMA_BASE_URL points at a proxy/tunnel that requires auth.
# OLLAMA_API_KEY=

# Must match a model you've pulled: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Must be one of the ids in lib/ai/config.ts CHAT_MODELS, and must be pulled
# locally, e.g.: ollama pull gemma3:1b
OLLAMA_DEFAULT_MODEL=gemma3:1b
